# List directory content after cd.
cd () {
    builtin cd $1
    ls
}

# Create directory and then enter it.
function mkcd () { 
    mkdir -p "${1}" && cd "${1}"
}

# Search command history.
hgrep() {
    history | grep "$1"
}

# Backup a file.
backup() {
    cp "$1" "$1.bak"
}

# Extract any archive.
extract() {
    case "$1" in
        *.tar.gz) tar xzf "$1" ;;
        *.tar.bz2) tar xjf "$1" ;;
        *.zip) unzip "$1" ;;
        *.tar) tar xf "$1" ;;
        *) echo "Unknown format" ;;
    esac
}

# Kill process by name.
killname() {
    pkill -f "$1"
}

# Copy the output of a command to clipboard (must be used in pipe).
clip() {
    wl-copy
}

# Same as 'copy()', but also prints the output on the terminal.
pasteclip() {
    tee >(wl-copy)
}

# Custom pandoc conversion .md -> .pdf.
mdpdf() {
    pandoc \
        -V geometry:margin=2.5cm \
        -V fontsize=11pt \
	-V colorlinks=true \
        -V linkcolor:blue \
        -V citecolor:blue \
        -V urlcolor:blue \
        "$@"
}